"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    heuristic_weight = 0.5\n    improved = True\n    while improved:\n        improved = False\n        next_node = min(unvisited_nodes, key=lambda node: distance_matrix[current_node][node] - heuristic_weight * distance_matrix[node][destination_node])\n        current_tour = [current_node, next_node]\n        heuristic_before = distance_matrix[current_node][next_node] - heuristic_weight * distance_matrix[next_node][destination_node]\n        for node in unvisited_nodes - {next_node}:\n            new_tour = [current_node, node]\n            heuristic_after = distance_matrix[current_node][node] - heuristic_weight * distance_matrix[node][destination_node]\n            if heuristic_after < heuristic_before:\n                current_tour = new_tour\n                heuristic_before = heuristic_after\n                improved = True\n        heuristic_weight = heuristic_weight * 1.1 if improved else heuristic_weight * 0.9\n    return next_node"