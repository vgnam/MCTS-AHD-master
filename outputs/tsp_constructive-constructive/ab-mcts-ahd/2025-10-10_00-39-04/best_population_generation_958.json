"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    remaining_nodes = len(unvisited_nodes)\n    weight_immediate_cost = 0.75 - 0.15 * (remaining_nodes / (remaining_nodes + 1))\n    weight_heuristic_term = 0.15 + 0.10 * (remaining_nodes / (remaining_nodes + 1))\n    weight_novelty_factor = 0.10 + 0.05 * (remaining_nodes / (remaining_nodes + 1))\n\n    def evaluate_node(node):\n        immediate_cost = distance_matrix[current_node][node]\n        heuristic_term = distance_matrix[current_node][destination_node] - distance_matrix[node][destination_node]\n        novelty_factor = sum(distance_matrix[node][n] for n in unvisited_nodes) / len(unvisited_nodes)\n\n        return (weight_immediate_cost * immediate_cost +\n                weight_heuristic_term * heuristic_term -\n                weight_novelty_factor * novelty_factor)\n\n    next_node = min(unvisited_nodes, key=lambda node: evaluate_node(node))\n    return next_node"