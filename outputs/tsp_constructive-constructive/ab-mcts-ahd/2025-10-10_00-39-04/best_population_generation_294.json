"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    if not unvisited_nodes:\n        return destination_node\n\n    remaining_nodes = len(unvisited_nodes)\n    total_nodes = len(distance_matrix)\n    proximity_weight = 0.5 + (0.5 * (remaining_nodes / (remaining_nodes + 1)))\n    destination_weight = 1.0 - proximity_weight\n    reduction_factor = 0.5 * (1 - remaining_nodes / total_nodes)\n\n    def node_score(node):\n        proximity = distance_matrix[current_node][node]\n        towards_destination = distance_matrix[node][destination_node]\n        reduction = (distance_matrix[current_node][destination_node] - distance_matrix[node][destination_node])\n        return (proximity_weight * proximity) + (destination_weight * towards_destination) + (reduction_factor * reduction)\n\n    next_node = min(unvisited_nodes, key=node_score)\n    return next_node"