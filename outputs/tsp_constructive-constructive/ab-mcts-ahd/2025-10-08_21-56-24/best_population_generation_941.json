"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    remaining_nodes = len(unvisited_nodes)\n    bias_towards_dest = 0.6\n    penalty_factor = 0.1 * remaining_nodes\n    adjusted_distances = {\n        node: distance_matrix[current_node][node] - (bias_towards_dest * distance_matrix[node][destination_node]) + penalty_factor\n        for node in unvisited_nodes\n    }\n    next_node = min(adjusted_distances, key=adjusted_distances.get)\n    return next_node"