"import math\n\ndef select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    def heuristic_score(node):\n        if node == destination_node:\n            return 0\n        remaining_nodes = len(unvisited_nodes)\n        total_nodes = len(distance_matrix)\n        local_weight = math.exp(-math.log2(remaining_nodes / total_nodes)) if remaining_nodes > 0 else 1.0\n        global_weight = 1.0 - local_weight\n        return local_weight * distance_matrix[current_node][node] + global_weight * distance_matrix[node][destination_node]\n\n    next_node = min(unvisited_nodes, key=lambda node: heuristic_score(node))\n    return next_node"