"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    total_unvisited = len(unvisited_nodes)\n    node_density = sum(len([n for n in unvisited_nodes if distance_matrix[current_node][n] <= 2]) for _ in unvisited_nodes) / total_unvisited\n    proximity_weight = 0.65 - 0.25 * (total_unvisited / (total_unvisited + len(distance_matrix))) + 0.15 * node_density\n    centrality_weight = 0.25 + 0.15 * (total_unvisited / (total_unvisited + len(distance_matrix))) - 0.1 * node_density\n    lookahead_weight = 0.2 - 0.2 * (total_unvisited / (total_unvisited + len(distance_matrix)))\n    initial_node_penalty_weight = 0.15 if current_node != destination_node else 0.0\n\n    def node_score(node):\n        proximity = distance_matrix[current_node][node]\n        centrality = sum(distance_matrix[node][n] for n in unvisited_nodes if n != node) / len(unvisited_nodes)\n        lookahead = sum(1 for n in unvisited_nodes if n != node and distance_matrix[node][n] < proximity)\n        initial_node_penalty = sum(distance_matrix[destination_node][n] for n in unvisited_nodes if n != node and distance_matrix[current_node][n] < 2)\n        return (proximity_weight * proximity) + (centrality_weight * centrality) + (lookahead_weight * lookahead) + (initial_node_penalty_weight * initial_node_penalty)\n\n    next_node = min(unvisited_nodes, key=node_score)\n    return next_node"