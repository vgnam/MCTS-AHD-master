"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    if destination_node in unvisited_nodes:\n        return destination_node\n    total_unvisited = len(unvisited_nodes)\n    node_density = sum(len([n for n in unvisited_nodes if distance_matrix[current_node][n] <= 2]) for _ in unvisited_nodes) / total_unvisited\n    proximity_weight = 0.7 - 0.3 * (total_unvisited / (total_unvisited + len(distance_matrix))) + 0.2 * node_density\n    centrality_weight = 0.3 + 0.2 * (total_unvisited / (total_unvisited + len(distance_matrix))) - 0.15 * node_density\n    lookahead_weight = 0.2 - 0.2 * (total_unvisited / (total_unvisited + len(distance_matrix)))\n\n    def node_score(node):\n        proximity = distance_matrix[current_node][node]\n        centrality = sum(distance_matrix[node][n] for n in unvisited_nodes if n != node) / len(unvisited_nodes)\n        lookahead = sum(1 for n in unvisited_nodes if n != node and distance_matrix[node][n] < proximity)\n        return (proximity_weight * proximity) + (centrality_weight * centrality) + (lookahead_weight * lookahead)\n\n    next_node = min(unvisited_nodes, key=node_score)\n    return next_node"