"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    def score(node):\n        weighted_dist = 0.7 * distance_matrix[current_node][node] + 0.3 * distance_matrix[node][destination_node]\n        return weighted_dist / (distance_matrix[current_node][node] + distance_matrix[node][destination_node])\n    next_node = min(unvisited_nodes, key=score)\n    return next_node"