"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    def score(node):\n        immediate_cost = distance_matrix[current_node][node]\n        destination_attraction = (1 / (1 + distance_matrix[node][destination_node])) ** 2\n        remaining_nodes = len(unvisited_nodes)\n        exploration_factor = sum(distance_matrix[node][n] for n in unvisited_nodes) / remaining_nodes if remaining_nodes else 0\n        dynamic_weight_immediate_cost = immediate_cost * (1 + 0.2 * (1 - remaining_nodes / total_nodes))\n        dynamic_weight_destination_attraction = destination_attraction * (1 + 0.2 * remaining_nodes / total_nodes)\n        alpha = 0.5 + 0.5 * (remaining_nodes / len(distance_matrix)) ** 1.5\n        return alpha * dynamic_weight_immediate_cost + (1 - alpha) * dynamic_weight_destination_attraction - 0.4 * exploration_factor\n\n    total_nodes = len(distance_matrix)\n    next_node = min(unvisited_nodes, key=score)\n    return next_node"