"def select_next_node(current_node, destination_node, unvisited_nodes, distance_matrix):\n    if not unvisited_nodes:\n        return None\n    avg_distances = {\n        node: sum(distance_matrix[node][other] for other in unvisited_nodes if other != node) / len(unvisited_nodes)\n        for node in unvisited_nodes\n    }\n    next_node = min(unvisited_nodes, key=lambda node: (distance_matrix[current_node][node] / (1 + distance_matrix[node][destination_node])) + (1 / (1 + avg_distances[node])))\n    return next_node"